<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false"
    android:paddingLeft="40mm" android:paddingRight="40mm" android:paddingTop="14mm" android:paddingBottom="14mm">
    <FrameLayout android:id="@+id/homeLayoutContent" android:layout_width="match_parent"
        android:layout_height="0mm" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false" />
    <TextView android:layout_width="match_parent" android:layout_height="32mm"
        android:text="方向键移动 · 确认键打开 · 返回键回上一页"
        android:textSize="19mm" android:textColor="@color/tv_text_secondary" android:gravity="center_vertical" />
    <LinearLayout android:id="@+id/tvUserHome" android:layout_width="match_parent" android:layout_height="104mm"
        android:orientation="horizontal" android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:id="@+id/tvHistory" style="@style/TvHomeShortcut" android:nextFocusLeft="@id/tvSetting">
            <ImageView style="@style/TvHomeShortcutIcon" android:src="@drawable/icon_history" />
            <TextView style="@style/TvHomeShortcutLabel" android:text="@string/tv_history" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvSearch" style="@style/TvHomeShortcut">
            <ImageView style="@style/TvHomeShortcutIcon" android:src="@drawable/icon_search" />
            <TextView style="@style/TvHomeShortcutLabel" android:text="@string/tv_search" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvPush" style="@style/TvHomeShortcut">
            <ImageView style="@style/TvHomeShortcutIcon" android:src="@drawable/icon_push" />
            <TextView style="@style/TvHomeShortcutLabel" android:text="@string/tv_push" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvFavorite" style="@style/TvHomeShortcut">
            <ImageView style="@style/TvHomeShortcutIcon" android:src="@drawable/icon_collect" />
            <TextView style="@style/TvHomeShortcutLabel" android:text="@string/tv_favorites" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvSetting" style="@style/TvHomeShortcut" android:nextFocusRight="@id/tvHistory">
            <ImageView style="@style/TvHomeShortcutIcon" android:src="@drawable/icon_setting" />
            <TextView style="@style/TvHomeShortcutLabel" android:text="@string/tv_settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
