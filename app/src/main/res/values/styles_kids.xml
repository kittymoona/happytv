<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KidsShortcut">
        <item name="android:layout_width">0mm</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">8mm</item>
        <item name="android:padding">16mm</item>
        <item name="android:textSize">32mm</item>
        <item name="android:textColor">@color/tv_text_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/tv_home_control_focus</item>
    </style>
</resources>
