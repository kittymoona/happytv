<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10mm" />
            <stroke android:width="2mm" android:color="@color/color_FFFFFF" />
            <solid android:color="@color/tv_surface_focused" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="10mm" />
            <stroke android:width="2mm" android:color="@color/color_FFFFFF_50" />
            <solid android:color="@color/tv_surface_focused" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="10mm" />
            <solid android:color="@color/tv_surface" />
        </shape>
    </item>
</selector>
