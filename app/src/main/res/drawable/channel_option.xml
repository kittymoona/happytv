<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape>
            <corners android:radius="18mm" />
            <solid android:color="@color/tv_focus" />
            <stroke android:width="2mm" android:color="@color/tv_text_on_focus" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="18mm" />
            <solid android:color="@color/tv_surface_focused" />
            <stroke android:width="2mm" android:color="@color/tv_focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape><corners android:radius="18mm" /><solid android:color="@color/tv_focus" /></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /></shape></item>
</selector>
